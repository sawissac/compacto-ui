{
  "name": "compacto-ui-workspace",
  "version": "0.0.0",
  "private": "false",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "pnpm --filter @compacto/ui build",
    "build:all": "pnpm -r build",
    "dev": "pnpm --filter @compacto/docs dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @compacto/ui test",
    "gates": "bash scripts/gates.sh",
    "release": "pnpm --filter @compacto/ui build && pnpm --filter @compacto/ui publish"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
