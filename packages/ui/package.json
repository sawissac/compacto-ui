{
  "name": "@compacto/ui",
  "version": "0.1.0",
  "description": "Flat, token-driven React primitives for the compacto design system.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sawissac/compacto-ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button.d.ts",
      "default": "./dist/components/button.js"
    },
    "./button-group": {
      "types": "./dist/components/button-group.d.ts",
      "default": "./dist/components/button-group.js"
    },
    "./calendar": {
      "types": "./dist/components/calendar.d.ts",
      "default": "./dist/components/calendar.js"
    },
    "./command": {
      "types": "./dist/components/command.d.ts",
      "default": "./dist/components/command.js"
    },
    "./dialog": {
      "types": "./dist/components/dialog.d.ts",
      "default": "./dist/components/dialog.js"
    },
    "./dropdown-menu": {
      "types": "./dist/components/dropdown-menu.d.ts",
      "default": "./dist/components/dropdown-menu.js"
    },
    "./error-boundary": {
      "types": "./dist/components/error-boundary.d.ts",
      "default": "./dist/components/error-boundary.js"
    },
    "./input": {
      "types": "./dist/components/input.d.ts",
      "default": "./dist/components/input.js"
    },
    "./popover": {
      "types": "./dist/components/popover.d.ts",
      "default": "./dist/components/popover.js"
    },
    "./resizable": {
      "types": "./dist/components/resizable.d.ts",
      "default": "./dist/components/resizable.js"
    },
    "./select": {
      "types": "./dist/components/select.d.ts",
      "default": "./dist/components/select.js"
    },
    "./separator": {
      "types": "./dist/components/separator.d.ts",
      "default": "./dist/components/separator.js"
    },
    "./skeleton": {
      "types": "./dist/components/skeleton.d.ts",
      "default": "./dist/components/skeleton.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs.d.ts",
      "default": "./dist/components/tabs.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "default": "./dist/components/tooltip.js"
    },
    "./cn": {
      "types": "./dist/lib/cn.d.ts",
      "default": "./dist/lib/cn.js"
    },
    "./ui-styles": {
      "types": "./dist/styles/ui.styles.d.ts",
      "default": "./dist/styles/ui.styles.js"
    },
    "./color-themes": {
      "types": "./dist/constants/color-themes.d.ts",
      "default": "./dist/constants/color-themes.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./theme.css": "./dist/styles/theme.css",
    "./compat-shadcn.css": "./dist/styles/compat-shadcn.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:js && pnpm run build:types && pnpm run build:css && pnpm run directives && pnpm run verify",
    "clean": "rm -rf dist",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:css": "mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "directives": "node scripts/directives.mjs",
    "verify": "publint && attw --pack . --config-path .attw.json",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.5.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "lucide-react": ">=1.11.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.10.0"
  },
  "peerDependenciesMeta": {
    "cmdk": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "jsdom": "^27.0.0",
    "lucide-react": "^1.16.0",
    "publint": "^0.3.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.11.1",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
